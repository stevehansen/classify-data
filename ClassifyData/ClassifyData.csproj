<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" />
    <PackageReference Include="Vidyano.SqlServer" Version="6.0.20261026.6659" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="App_Data\**;appsettings.json;wwwroot\favicon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Restored by libman.json during build, so not globbed. -->
    <Content Include="wwwroot\dist\index.min.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
