{
  "extends": [
    "github>stevehansen/renovate-config",
		":rebaseStalePrs"
  ],
	"assigneesFromCodeOwners": true,
	"customManagers": [
		{
			"customType": "regex",
			"description": "Client libraries restored by libman (jsdelivr = npm)",
			"managerFilePatterns": ["/(^|/)libman\\.json$/"],
			"matchStrings": ["\"library\": \"(?<depName>(@[^/\"]+/)?[^@\"]+)@(?<currentValue>[^\"]+)\""],
			"datasourceTemplate": "npm"
		}
	],
	"packageRules": [
    {
      "matchPackageNames": ["/ThisAssembly/"],
      "groupName": "ThisAssembly"
    },
		{
      "matchPackageNames": ["/vidyano/i"],
      "groupName": "Vidyano"
    },
		{
      "matchPackageNames": ["/CefSharp/"],
      "groupName": "CefSharp"
    }
  ]
}
